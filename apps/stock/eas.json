{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.11.0",
      "pnpm": "9.15.0",
      "cache": {
        "disabled": false,
        "key": "palmart-mobile-free"
      },
      "android": {
        "resourceClass": "medium"
      },
      "ios": {
        "resourceClass": "medium"
      }
    },
    "production": {
      "extends": "base",
      "channel": "generic-stock-production",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "generic-stock-preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "palmart": {
      "extends": "production",
      "channel": "palmart-production",
      "env": {
        "KIOSK_TENANT": "palmart",
        "TENANT_ID": "palmart"
      }
    },
    "palmart-preview": {
      "extends": "preview",
      "channel": "palmart-preview",
      "env": {
        "KIOSK_TENANT": "palmart",
        "TENANT_ID": "palmart"
      }
    },
    "tenant-production": {
      "extends": "production",
      "channel": "tenant-production"
    },
    "tenant-preview": {
      "extends": "preview",
      "channel": "tenant-preview"
    }
  },
  "submit": {
    "palmart": {
      "ios": {
        "appleTeamId": "APPLE_TEAM_ID",
        "ascAppId": "APP_STORE_CONNECT_APP_ID"
      },
      "android": {
        "serviceAccountKeyPath": "../../google-service-account.json",
        "track": "internal"
      }
    }
  }
}
